# 4. Projectile Ball Simulation

```text
START

IMPORT PYGAME

INITIALIZE Pygame
SET screen width and height
CREATE game window
CREATE clock

SET colors
SET gravity
SET launch position
SET initial ball position
SET initial ball velocity
SET flying state to FALSE
SET dragging state to FALSE

SET running to TRUE

WHILE running is TRUE

    CLEAR the screen
    DRAW the ground
    GET current mouse position

    FOR each event

        IF event is QUIT
            SET running to FALSE
        END IF

        IF mouse button is pressed AND ball is not flying
            SET dragging to TRUE
        END IF

        IF mouse button is released AND ball is being dragged
            SET dragging to FALSE
            SET flying to TRUE

            CALCULATE ball velocity from the drag distance
        END IF

    END FOR

    IF ball is flying

        APPLY gravity to vertical velocity

        UPDATE horizontal position
        UPDATE vertical position

        IF ball hits the ground OR goes off screen
            SET flying to FALSE
            RESET ball to launch position
            RESET velocity to zero
        END IF

    END IF

    IF ball is being dragged
        DRAW line from launch point to mouse position
        DRAW ball at mouse position
    ELSE
        DRAW ball at its current position
    END IF

    DRAW launch point

    UPDATE the display
    LIMIT the game to 60 frames per second

END WHILE

QUIT Pygame

END
```

